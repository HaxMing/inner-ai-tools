# FastAPI server is intended to run on this Windows machine:
# uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload

OLLAMA_BASE_URL=http://192.168.1.106:11434

DIFY_BASE_URL=http://192.168.1.102
DIFY_HEALTH_PATH=/health

MILVUS_HOST=192.168.1.102
MILVUS_PORT=19530

HTTP_TIMEOUT_SECONDS=3
DOCKER_TIMEOUT_SECONDS=5
SOCKET_TIMEOUT_SECONDS=3

# cli: check Docker on the machine running this FastAPI service.
# ssh: check Docker on a remote Linux server through SSH.
DOCKER_CHECK_MODE=cli
DOCKER_COMMAND=docker
DOCKER_SSH_HOST=192.168.1.102
DOCKER_SSH_PORT=22
DOCKER_SSH_USERNAME=root
# Do not commit a real password into .env files.
DOCKER_SSH_PASSWORD=
DOCKER_SSH_KEY_PATH=
DOCKER_SSH_COMMAND=docker info --format '{{.ServerVersion}}'
